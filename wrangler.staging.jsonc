{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "villow-review-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "review-staging.villow.app", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "REVIEW_ORIGIN": "https://review-staging.villow.app"
  },
  "secrets": {
    "required": [
      "REVIEW_SUPABASE_URL",
      "REVIEW_SUPABASE_SERVICE_ROLE_KEY",
      "REVIEW_GOOGLE_CLIENT_ID",
      "REVIEW_GOOGLE_CLIENT_SECRET",
      "REVIEW_TOKEN_ENCRYPTION_KEY",
      "REVIEW_SESSION_SIGNING_KEY",
      "REVIEW_INVITE_TOKEN"
    ]
  }
}
