{
  "name": "@villow/review-environment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc",
    "build:staging": "wrangler deploy --dry-run --config wrangler.staging.jsonc --outdir dist-staging",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "deploy": "node scripts/deploy.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "admin": "node scripts/admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
